      "stages": [
        {
          "title": "PROCEDIMIENTO EN THERMOMIX GRANDE",
          "procedureTitle": null,
          "description": "Salmorreta RTMY. Base para las paellas (C23–C25), el tomate confitado (B08), las alcachofas (C11) y la burrata (C12).",
          "ingredients": [
            {
              "qty": 1875,
              "unit": "g",
              "name": "Tomate"
            },
            {
              "qty": 405,
              "unit": "g",
              "name": "Aceite de Oliva"
